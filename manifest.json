{
  "manifest_version": 3,
  "name": "Private Browser Toolkit",
  "description": "A private browser toolkit for chrome.",
  "version": "0.3.0",
  "action": {},
  "options_page": "options.html",
  "permissions": ["tabs", "tabGroups", "storage", "unlimitedStorage"],
  "icons": {
    "16": "icon/icon_16.png",
    "32": "icon/icon_32.png",
    "48": "icon/icon_48.png",
    "128": "icon/icon_128.png",
    "512": "icon/icon_512.png"
  },
  "background": {
    "service_worker": "worker/index.js",
    "type": "module"
  }
}
