{
  "manifest_version": 3,
  "name": "Private Browser Toolkit",
  "description": "自动合并重复标签、整合全屏窗口，并在本地备份标签组；所有数据仅保存在浏览器中。",
  "version": "0.4.0",
  "action": {},
  "options_page": "options.html",
  "permissions": ["tabs", "tabGroups", "storage", "unlimitedStorage"],
  "icons": {
    "16": "icon/icon_16.png",
    "32": "icon/icon_32.png",
    "48": "icon/icon_48.png",
    "128": "icon/icon_128.png",
    "512": "icon/icon_512.png"
  },
  "background": {
    "service_worker": "worker/index.js",
    "type": "module"
  }
}
